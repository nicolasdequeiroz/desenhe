{
  "name": "desenhe-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite-react-ssg build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:pages": "rm -rf docs && tsc -b && BASE_PATH=/desenhe/ BUILD_OUT_DIR=docs vite-react-ssg build && cp docs/index.html docs/404.html && touch docs/.nojekyll"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "matter-js": "^0.20.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vite-react-ssg": "^0.9.1-beta.1"
  }
}
